{
  "name": "community-disaster-management-system",
  "version": "1.0.0",
  "description": "Full-Stack MERN Community Disaster Management and Resource Allocation System",
  "scripts": {
    "start": "npm run start:backend",
    "build": "npm run install:all && npm run build:frontend",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "seed": "cd backend && node src/seed.js",
    "start:backend": "cd backend && node src/server.js",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.0",
    "multer": "^2.1.1"
  },
  "keywords": [
    "mern",
    "disaster-management",
    "resource-allocation",
    "mongodb",
    "react",
    "express",
    "nodejs",
    "leaflet"
  ],
  "author": "Disaster Management Engineering Team",
  "license": "MIT"
}
